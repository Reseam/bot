#!/bin/sh
set -eu
cdn=https://cdn.reseam.app
dir=/opt/reseam
mkdir -p "$dir"

cli=$(curl -fsS --retry 3 https://git.reseam.app/api/v1/repos/reseam/reseam/releases/latest | jq -er .tag_name)
if [ "$(cat "$dir/cli-version" 2>/dev/null)" != "$cli" ]; then
  curl -fsSL --retry 3 -o "$dir/reseam.part" "$cdn/engine/$cli/reseam-linux-x64"
  chmod +x "$dir/reseam.part"
  mv "$dir/reseam.part" /usr/local/bin/reseam
  echo "$cli" > "$dir/cli-version"
fi

curl -fsSL --retry 3 -o "$dir/patches.json.part" "$cdn/patches/patches.json"
patches=v$(jq -er 'first(.releases[] | select(.prerelease | not)).version' "$dir/patches.json.part")
if [ "$(cat "$dir/patches-version" 2>/dev/null)" != "$patches" ]; then
  curl -fsSL --retry 3 -o "$dir/reseam-patches.part" "$cdn/patches/$patches/reseam-patches.reseam"
  jq -er .bundle.public_key "$dir/patches.json.part" > "$dir/public-key"
  mv "$dir/patches.json.part" "$dir/patches.json"
  mv "$dir/reseam-patches.part" "$dir/reseam-patches.reseam"
  echo "$patches" > "$dir/patches-version"
fi
rm -f "$dir/patches.json.part"
